# macOS
.DS_Store

# Node / pnpm
node_modules/
.pnpm-store/

# Local environment & secrets (templates are committed; resolved files are ignored)
.env
.env.local
.mcp.json

# Personal Claude notes (per CLAUDE.md "個人ノート")
CLAUDE.local.md

# Claude Code runtime artifacts
.claude/worktrees/
.claude/scheduled_tasks.lock

# ReScript build artifacts
lib/
# In-source compiled output: kept in npm publish (via package.json `files`)
# but ignored in git so working tree stays clean.
**/*.res.mjs

# Sphinx build outputs
sphinx-docs/_build/

# gettext compiled message catalogs (generated from .po by make build-ja)
sphinx-docs/locale/**/*.mo

# Editors
.vscode/
.idea/

# Coverage / test outputs
coverage/

# Logs / temp
*.log
.tmp/

# Rust build artifacts
target/
**/target/
Cargo.lock
