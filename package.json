{
  "name": "rescript-tauri-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo root for rescript-tauri (private; not published)",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "clean": "pnpm --recursive --if-present run clean",
    "test": "pnpm --recursive --if-present test",
    "format": "oxfmt \"**/*.mjs\" \"**/*.json\"",
    "format:check": "oxfmt --check \"**/*.mjs\" \"**/*.json\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "oxlint && oxfmt --check \"**/*.mjs\" \"**/*.json\"",
    "check:fix": "oxlint --fix && oxfmt \"**/*.mjs\" \"**/*.json\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "^1.73.0"
  },
  "packageManager": "pnpm@11.0.9"
}
