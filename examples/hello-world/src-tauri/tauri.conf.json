{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rescript-tauri-hello-world",
  "version": "0.0.0",
  "identifier": "com.rescript-tauri.example.hello-world",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "rescript-tauri hello world",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  }
}
