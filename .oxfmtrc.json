{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.res.mjs",
    "**/lib/**",
    "**/target/**",
    "sphinx-docs/**",
    "examples/*/src-tauri/**",
    "**/pnpm-lock.yaml",
    "**/Cargo.lock",
    "**/.claude/worktrees/**"
  ]
}
